@page "/profile-selector"
@layout AuthLayout
@inject NavigationManager Navigation

<div class="profile-selector-screen">
    <div class="profile-selector-header">
        <EcoWordmark />
    </div>

    <div class="profile-selector-content">
        <div class="profile-selector-headline">
            <h1>Cadastrar empresa</h1>
            <p>Escolha o tipo de operação</p>
        </div>

        <div class="profile-selector-options" role="group" aria-label="Tipo de empresa">
            <EcoSelectorButton Label="Ponto de coleta"
                               Selected="false"
                               OnClick="@(() => Navigation.NavigateTo("/register/collect-point"))">
                <LeadingIcon>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.75"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M3 21h18M5 21V7l7-4 7 4v14M9 9h.01M9 13h.01M9 17h.01M15 9h.01M15 13h.01M15 17h.01" />
                    </svg>
                </LeadingIcon>
            </EcoSelectorButton>

            <div class="profile-selector-soon">
                <EcoSelectorButton Label="Coletor" Selected="false" Disabled="true" OnClick="_noop" />
                <span class="profile-selector-soon__tag">Em breve</span>
            </div>
        </div>

        <div class="profile-selector-back">
            <EcoGhostButton Label="Voltar" OnClick="OnBack" />
        </div>
    </div>
</div>

@code {
    private void OnBack() => Navigation.NavigateTo("/map");
    private readonly EventCallback _noop = EventCallback.Empty;
}
