@page "/login"
@layout AuthLayout
@using Refit
@implements IDisposable
@inject IAccountClient Api
@inject NavigationManager Navigation

<div class="login-screen">
    <div class="login-content">
        <div class="login-brand">
            <EcoLogoLockup Size="EcoLogoSize.Lg" />
        </div>

        <EcoAuthHeadline Title="Entrar"
                         Subtitle="Enviaremos um código para o seu e-mail" />

        <div class="login-field">
            <EcoTextField Placeholder="E-mail"
                          Type="email"
                          Value="@_email"
                          ValueChanged="@(v => _email = v)"
                          HasError="@(_errorMessage is not null)">
                <Icon>
                    <MudIcon Icon="@Icons.Material.Filled.Email"
                             Color="Color.Inherit"
                             Size="Size.Small" />
                </Icon>
            </EcoTextField>
        </div>

        @if (_errorMessage is not null)
        {
            <p class="login-error" role="alert">@_errorMessage</p>
        }

        <EcoPrimaryButton Label="Entrar"
                          OnClick="HandleSubmit"
                          Disabled="@(!IsFormValid)"
                          IsLoading="@_loading" />
    </div>

    <div class="login-footer">
        <EcoGhostButton Label="Voltar para a home" OnClick="GoHome" />
    </div>
</div>

@code {
    private string _email = string.Empty;
    private bool _loading;
    private string? _errorMessage;
    private readonly CancellationTokenSource _cts = new();

    private bool IsFormValid => Regex.IsMatch(_email.Trim(), @"\S+@\S+\.\S+");

    private async Task HandleSubmit()
    {
        if (!IsFormValid || _loading) return;
        _loading = true;
        _errorMessage = null;

        try
        {
            var response = await RequestLoginCodeWithRetryAsync();

            if (response.IsSuccessStatusCode)
            {
                _loading = false;
                Navigation.NavigateTo($"/login/verify?email={Uri.EscapeDataString(_email.Trim())}");
            }
            else
            {
                _errorMessage = "Não foi possível enviar o código. Tente novamente.";
                _loading = false;
            }
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
            // Página abandonada durante a requisição — descarta sem atualizar estado.
        }
        catch (Exception)
        {
            // Falha de rede (HttpRequestException, timeout) não pode derrubar o circuito
            // Blazor — vira erro inline com retry manual.
            _errorMessage = "Falha de conexão. Verifique sua internet e tente novamente.";
            _loading = false;
        }
    }

    /// <summary>
    /// No Android, a primeira conexão HTTPS do processo pode falhar durante o warm-up
    /// do provedor de segurança do Google Play Services (DEVELOPER_ERROR no logcat);
    /// a repetição imediata funciona. Retry único apenas para falha de transporte.
    /// </summary>
    private async Task<IApiResponse> RequestLoginCodeWithRetryAsync()
    {
        var request = new RequestRequestLoginCode { Email = _email.Trim() };
        try
        {
            return await Api.RequestLoginCodeAsync(request, _cts.Token);
        }
        catch (HttpRequestException)
        {
            return await Api.RequestLoginCodeAsync(request, _cts.Token);
        }
    }

    private void GoHome() => Navigation.NavigateTo("/");

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
