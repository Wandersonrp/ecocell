@page "/"
@layout AuthLayout
@inject NavigationManager Navigation

<div class="welcome-screen">
    <div class="welcome-body">
        <EcoLogoLockup Size="EcoLogoSize.Lg" />

        <div class="welcome-headline">
            <h1>Bem-vindo ao EcoCell</h1>
            <p>Cadastre-se ou faça login</p>
        </div>
    </div>

    <div class="welcome-actions">
        <EcoPrimaryButton Label="Cadastrar" OnClick="OnSignUp" />
        <EcoSecondaryButton Label="Entrar" OnClick="OnSignIn" />
    </div>
</div>

@code {
    private void OnSignUp() => Navigation.NavigateTo("/register/natural-person");
    private void OnSignIn() => Navigation.NavigateTo("/login");
}
