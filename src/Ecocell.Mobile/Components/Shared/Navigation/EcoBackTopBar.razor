<div class="eco-back-topbar">
    <button type="button" class="eco-back-topbar__back" @onclick="OnBack" aria-label="Voltar" disabled="@Disabled">
        <MudIcon Icon="@Icons.Material.Filled.ArrowBack" aria-hidden="true" />
    </button>
    <span class="eco-back-topbar__title">@Title</span>
    <span class="eco-back-topbar__spacer" aria-hidden="true"></span>
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = default!;

    [Parameter, EditorRequired]
    public EventCallback OnBack { get; set; }

    [Parameter]
    public bool Disabled { get; set; }
}
