@* EcoLogoMark - SVG logo with recycling arcs and tree glyph *@
<div class="eco-logo-mark" role="img" aria-label="EcoCell">
    <svg width="@Size"
         height="@Size"
         viewBox="0 0 100 100"
         fill="none"
         xmlns="http://www.w3.org/2000/svg"
         aria-hidden="true">
        <g stroke="currentColor"
           stroke-width="@(Size * 0.085)"
           stroke-linecap="round"
           stroke-linejoin="round">
            <path d="M 50 8 A 42 42 0 0 1 86.4 71 L 82 63" />
            <path d="M 86.4 71 L 78 73 L 80 81" />
            <path d="M 86.4 29 A 42 42 0 0 1 50 92 L 58 88" />
            <path d="M 50 92 L 56 86 L 48 80" />
            <path d="M 13.6 71 A 42 42 0 0 1 13.6 29 L 22 33" />
            <path d="M 13.6 29 L 22 27 L 22 19" />
        </g>
        <g fill="currentColor">
            <circle cx="50" cy="42" r="6" />
            <circle cx="42" cy="48" r="6" />
            <circle cx="58" cy="48" r="6" />
            <circle cx="46" cy="38" r="5" />
            <circle cx="54" cy="38" r="5" />
            <rect x="48" y="50" width="4" height="14" rx="1" />
        </g>
    </svg>
</div>

@code {
    [Parameter]
    public int Size { get; set; } = 96;
}
