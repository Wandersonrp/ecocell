@using Ecocell.Mobile.Services.Auth
@using Ecocell.Mobile.Services.Api
@using Ecocell.Mobile.Services.Context
@using Ecocell.Mobile.Services.Notifications
@using Ecocell.Shared.Enums
@inject AuthStateService AuthState
@inject ICollectorPointClient CollectorPointClient
@inject ActiveContextService Context
@inject PendingDiscardMonitor Monitor
@inject NavigationManager Navigation
@implements IDisposable

<Router AppAssembly="typeof(MauiProgram).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>

@code {
    protected override void OnInitialized()
    {
        AuthState.AuthStateChanged += OnAuthStateChanged;
        Monitor.NotificationTargetAvailable += OnNotificationTargetAvailable;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await OpenNotificationTargetAsync();
    }

    /// <summary>
    /// Única navegação pós-logout do app: reage a sign-out forçado (refresh token
    /// expirado, tratado em AuthTokenHandler) e a sign-out manual (botão Sair em
    /// Profile.razor). Fica em Routes.razor (raiz sempre montada) e não em
    /// MainLayout, porque telas sob AuthLayout (ex.: RegisterCollectPoint) também
    /// fazem chamadas autenticadas e precisam ser cobertas pelo mesmo listener.
    /// Ambos os chamadores de SignOutAsync só limpam a sessão — não navegam.
    /// </summary>
    private void OnAuthStateChanged()
    {
        if (!AuthState.IsAuthenticated)
        {
            InvokeAsync(() => Navigation.NavigateTo("/", replace: true));
            return;
        }

        _ = InvokeAsync(OpenNotificationTargetAsync);
    }

    private void OnNotificationTargetAvailable() => _ = InvokeAsync(OpenNotificationTargetAsync);

    private async Task OpenNotificationTargetAsync()
    {
        if (!AuthState.IsAuthenticated
            || !Monitor.TryGetNotificationTarget(out var collectorPointId))
        {
            return;
        }

        var sessionGeneration = AuthState.SessionGeneration;
        var response = await CollectorPointClient.ListMineAsync();
        if (!AuthState.IsAuthenticated || AuthState.SessionGeneration != sessionGeneration)
            return;

        var point = response.IsSuccessStatusCode
            ? response.Content?.Items.FirstOrDefault(value =>
                value.Id == collectorPointId && value.Status == PersonStatus.Active)
            : null;

        if (point is null)
            return;

        Context.EnterCollectPoint(point.Id, point.TradeName);
        Navigation.NavigateTo("/ponto-de-coleta/descartes-pendentes");
        Monitor.ClearNotificationTarget(collectorPointId);
    }

    public void Dispose()
    {
        AuthState.AuthStateChanged -= OnAuthStateChanged;
        Monitor.NotificationTargetAvailable -= OnNotificationTargetAvailable;
    }
}
