  <ItemGroup>
    <ProjectReference Include="..\Ecocell.Shared\Ecocell.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ecocell.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Features\" />
